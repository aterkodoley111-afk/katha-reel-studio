 "phrases": [
  {
   "s": 0.0,
   "e": 1.33,
   "text": "एक ऐसा राक्षस,",
   "chunks": [
    [
     0.0,
     1.33
    ]
   ]
  },
  {
   "s": 1.73,
   "e": 4.56,
   "text": "जिसे भगवान शिव ने खुद अमर जैसी शक्ति दे दी...",
   "chunks": [
    [
     1.73,
     4.56
    ]
   ]
  },
  {
   "s": 5.21,
   "e": 9.79,
   "text": "लेकिन वरदान मिलते ही उसने सबसे पहले महादेव को ही मारने की कोशिश की!",
   "chunks": [
    [
     5.21,
     9.79
    ]
   ]
  },
  {
   "s": 10.59,
   "e": 12.09,
   "text": "आखिर कौन था ये राक्षस,",
   "chunks": [
    [
     10.59,
     12.09
    ]
   ]
  },
  {
   "s": 12.54,
   "e": 15.28,
   "text": "और कैसे उसी के वरदान ने उसकी जान ले ली?",
   "chunks": [
    [
     12.54,
     15.28
    ]
   ]
  },
  {
   "s": 16.21,
   "e": 18.37,
   "text": "इस राक्षस का नाम था भस्मासुर।",
   "chunks": [
    [
     16.21,
     18.37
    ]
   ]
  },
  {
   "s": 19.04,
   "e": 21.32,
   "text": "वह भगवान शिव का बहुत बड़ा भक्त था।",
   "chunks": [
    [
     19.04,
     21.32
    ]
   ]
  },
  {
   "s": 21.92,
   "e": 24.96,
   "text": "उन्हें प्रसन्न करने के लिए उसने कठोर तपस्या की।",
   "chunks": [
    [
     21.92,
     24.96
    ]
   ]
  },
  {
   "s": 25.61,
   "e": 26.21,
   "text": "आखिरकार,",
   "chunks": [
    [
     25.61,
     26.21
    ]
   ]
  },
  {
   "s": 26.59,
   "e": 33.01,
   "text": "उसकी तपस्या से प्रसन्न होकर भगवान शिव उसके सामने प्रकट हुए और उसे वरदान मांगने को कहा।",
   "chunks": [
    [
     26.59,
     30.78
    ],
    [
     31.18,
     33.01
    ]
   ]
  },
  {
   "s": 33.84,
   "e": 36.77,
   "text": "भस्मासुर ने एक ऐसा खतरनाक वरदान मांगा,",
   "chunks": [
    [
     33.84,
     36.77
    ]
   ]
  },
  {
   "s": 37.2,
   "e": 39.45,
   "text": "जिसे सुनकर कोई भी हैरान रह जाए।",
   "chunks": [
    [
     37.2,
     39.45
    ]
   ]
  },
  {
   "s": 40.09,
   "e": 43.51,
   "text": "उसने मांगा कि वह जिसके भी सिर पर अपना हाथ रखेगा,",
   "chunks": [
    [
     40.09,
     40.72
    ],
    [
     41.08,
     43.51
    ]
   ]
  },
  {
   "s": 43.93,
   "e": 46.24,
   "text": "वह तुरंत जलकर भस्म हो जाएगा।",
   "chunks": [
    [
     43.93,
     46.24
    ]
   ]
  },
  {
   "s": 47.12,
   "e": 51.33,
   "text": "भगवान शिव ने उसकी इच्छा पूरी कर दी और उसे यह शक्ति दे दी।",
   "chunks": [
    [
     47.12,
     49.36
    ],
    [
     49.76,
     51.33
    ]
   ]
  },
  {
   "s": 52.02,
   "e": 55.26,
   "text": "लेकिन वरदान मिलते ही भस्मासुर की नीयत बदल गई।",
   "chunks": [
    [
     52.02,
     55.26
    ]
   ]
  },
  {
   "s": 55.91,
   "e": 59.41,
   "text": "वह अपनी शक्ति का इस्तेमाल भगवान शिव पर ही करना चाहता था!",
   "chunks": [
    [
     55.91,
     59.41
    ]
   ]
  },
  {
   "s": 60.18,
   "e": 63.65,
   "text": "अपनी जान बचाने के लिए भगवान शिव वहां से निकल पड़े।",
   "chunks": [
    [
     60.18,
     63.65
    ]
   ]
  },
  {
   "s": 64.45,
   "e": 68.36,
   "text": "अब समस्या यह थी कि भस्मासुर को रोकना बेहद मुश्किल था,",
   "chunks": [
    [
     64.45,
     65.63
    ],
    [
     65.99,
     68.36
    ]
   ]
  },
  {
   "s": 68.88,
   "e": 72.13,
   "text": "क्योंकि उसके पास खुद महादेव का दिया हुआ वरदान था।",
   "chunks": [
    [
     68.88,
     72.13
    ]
   ]
  },
  {
   "s": 72.93,
   "e": 78.55,
   "text": "तभी भगवान विष्णु ने इस संकट को समाप्त करने के लिए मोहिनी का रूप धारण किया।",
   "chunks": [
    [
     72.93,
     78.55
    ]
   ]
  },
  {
   "s": 79.3,
   "e": 82.42,
   "text": "मोहिनी के रूप को देखकर भस्मासुर मोहित हो गया।",
   "chunks": [
    [
     79.3,
     82.42
    ]
   ]
  },
  {
   "s": 83.06,
   "e": 88.55,
   "text": "मोहिनी ने नृत्य करना शुरू किया और भस्मासुर भी उनकी नकल करते हुए नाचने लगा।",
   "chunks": [
    [
     83.06,
     88.55
    ]
   ]
  },
  {
   "s": 89.21,
   "e": 92.99,
   "text": "नृत्य करते-करते मोहिनी ने अपना हाथ अपने सिर पर रखा।",
   "chunks": [
    [
     89.21,
     92.99
    ]
   ]
  },
  {
   "s": 93.58,
   "e": 99.69,
   "text": "भस्मासुर ने भी बिना सोचे-समझे उनकी नकल की और अपना हाथ अपने ही सिर पर रख लिया!",
   "chunks": [
    [
     93.58,
     97.07
    ],
    [
     97.43,
     99.69
    ]
   ]
  },
  {
   "s": 100.3,
   "e": 101.3,
   "text": "और अगले ही पल,",
   "chunks": [
    [
     100.3,
     101.3
    ]
   ]
  },
  {
   "s": 101.68,
   "e": 105.34,
   "text": "अपने ही वरदान की वजह से वह जलकर भस्म हो गया।",
   "chunks": [
    [
     101.68,
     105.34
    ]
   ]
  },
  {
   "s": 106.04,
   "e": 109.56,
   "text": "जिस शक्ति को पाकर वह खुद को अजेय समझने लगा था,",
   "chunks": [
    [
     106.04,
     109.56
    ]
   ]
  },
  {
   "s": 110.0,
   "e": 111.94,
   "text": "वही उसकी मौत का कारण बन गई।",
   "chunks": [
    [
     110.0,
     111.94
    ]
   ]
  },
  {
   "s": 112.77,
   "e": 115.2,
   "text": "इस कहानी से एक बात सीखने को मिलती है...",
   "chunks": [
    [
     112.77,
     115.2
    ]
   ]
  },
  {
   "s": 116.01,
   "e": 117.97,
