 "phrases": [
  {
   "s": 0.0,
   "e": 1.7,
   "text": "महाभारत का वो योद्धा,",
   "chunks": [
    [
     0.0,
     1.7
    ]
   ]
  },
  {
   "s": 2.08,
   "e": 6.4,
   "text": "जिसे भगवान कृष्ण ने तीन हज़ार साल तक भटकने का श्राप दिया था!",
   "chunks": [
    [
     2.08,
     6.4
    ]
   ]
  },
  {
   "s": 7.11,
   "e": 8.84,
   "text": "उसका नाम था अश्वत्थामा।",
   "chunks": [
    [
     7.11,
     8.84
    ]
   ]
  },
  {
   "s": 9.48,
   "e": 12.76,
   "text": "वो गुरु द्रोणाचार्य का पुत्र और एक महान योद्धा था।",
   "chunks": [
    [
     9.48,
     12.76
    ]
   ]
  },
  {
   "s": 13.45,
   "e": 16.24,
   "text": "उसके माथे पर जन्म से ही एक दिव्य मणि थी,",
   "chunks": [
    [
     13.45,
     16.24
    ]
   ]
  },
  {
   "s": 16.62,
   "e": 18.46,
   "text": "जो उसे कई खतरों से बचाती थी।",
   "chunks": [
    [
     16.62,
     18.46
    ]
   ]
  },
  {
   "s": 19.22,
   "e": 25.68,
   "text": "लेकिन महाभारत के युद्ध में अपने पिता की मृत्यु के बाद अश्वत्थामा बदले की आग में अंधा हो गया।",
   "chunks": [
    [
     19.22,
     22.53
    ],
    [
     22.96,
     25.68
    ]
   ]
  },
  {
   "s": 26.57,
   "e": 28.0,
   "text": "युद्ध समाप्त होने के बाद,",
   "chunks": [
    [
     26.57,
     28.0
    ]
   ]
  },
  {
   "s": 28.42,
   "e": 33.71,
   "text": "एक रात उसने पांडवों के शिविर में सो रहे द्रौपदी के पाँचों पुत्रों की हत्या कर दी।",
   "chunks": [
    [
     28.42,
     33.71
    ]
   ]
  },
  {
   "s": 34.55,
   "e": 36.66,
   "text": "जब अर्जुन ने उसे पकड़ने की कोशिश की,",
   "chunks": [
    [
     34.55,
     36.66
    ]
   ]
  },
  {
   "s": 37.05,
   "e": 39.45,
   "text": "तो अश्वत्थामा ने ब्रह्मशिरास्त्र चला दिया।",
   "chunks": [
    [
     37.05,
     39.45
    ]
   ]
  },
  {
   "s": 40.25,
   "e": 42.28,
   "text": "अर्जुन ने भी अपना दिव्य अस्त्र चलाया।",
   "chunks": [
    [
     40.25,
     42.28
    ]
   ]
  },
  {
   "s": 42.89,
   "e": 48.1,
   "text": "लेकिन अश्वत्थामा ने अपने अस्त्र को उत्तरा के गर्भ में पल रहे बच्चे की ओर मोड़ दिया।",
   "chunks": [
    [
     42.89,
     48.1
    ]
   ]
  },
  {
   "s": 48.85,
   "e": 50.35,
   "text": "वो बच्चा था परीक्षित।",
   "chunks": [
    [
     48.85,
     50.35
    ]
   ]
  },
  {
   "s": 51.1,
   "e": 58.09,
   "text": "भगवान कृष्ण ने उसकी रक्षा की और अश्वत्थामा को तीन हज़ार साल तक पीड़ा के साथ भटकने का श्राप दिया।",
   "chunks": [
    [
     51.1,
     52.95
    ],
    [
     53.38,
     58.09
    ]
   ]
  },
  {
   "s": 58.89,
   "e": 61.23,
   "text": "उसकी माथे की मणि भी उससे छीन ली गई।",
   "chunks": [
    [
     58.89,
     61.23
    ]
   ]
  },
  {
   "s": 62.05,
   "e": 66.09,
   "text": "इस तरह एक महान योद्धा को अपनी ही गलतियों की ऐसी सज़ा मिली,",
   "chunks": [
    [
     62.05,
     66.09
    ]
   ]
  },
  {
   "s": 66.09,
   "e": 68.1,
