 "phrases": [
  {
   "s": 0.0,
   "e": 3.81,
   "text": "महाभारत के सबसे महान योद्धाओं में से एक कर्ण...",
   "chunks": [
    [
     0.0,
     3.06
    ],
    [
     3.47,
     3.81
    ]
   ]
  },
  {
   "s": 4.43,
   "e": 7.9,
   "text": "जिसके पास जन्म से ही ऐसा दिव्य कवच और कुंडल थे,",
   "chunks": [
    [
     4.43,
     7.9
    ]
   ]
  },
  {
   "s": 8.28,
   "e": 10.2,
   "text": "जो उसे लगभग अजेय बनाते थे।",
   "chunks": [
    [
     8.28,
     10.2
    ]
   ]
  },
  {
   "s": 10.91,
   "e": 12.15,
   "text": "लेकिन क्या तुम जानते हो,",
   "chunks": [
    [
     10.91,
     12.15
    ]
   ]
  },
  {
   "s": 12.59,
   "e": 15.69,
   "text": "जिस योद्धा को पूरी दुनिया सूतपुत्र समझती रही,",
   "chunks": [
    [
     12.59,
     15.69
    ]
   ]
  },
  {
   "s": 16.18,
   "e": 18.93,
   "text": "वह असल में कुंती का सबसे बड़ा बेटा था!",
   "chunks": [
    [
     16.18,
     18.93
    ]
   ]
  },
  {
   "s": 19.58,
   "e": 24.53,
   "text": "आखिर एक राजकुमारी ने अपने ही बेटे को जन्म लेते ही नदी में क्यों बहा दिया?",
   "chunks": [
    [
     19.58,
     24.53
    ]
   ]
  },
  {
   "s": 25.25,
   "e": 26.94,
   "text": "इस रहस्य की शुरुआत तब हुई,",
   "chunks": [
    [
     25.25,
     26.94
    ]
   ]
  },
  {
   "s": 27.31,
   "e": 31.91,
   "text": "जब ऋषि दुर्वासा ने राजकुमारी कुंती को एक ऐसा दिव्य मंत्र दिया,",
   "chunks": [
    [
     27.31,
     31.91
    ]
   ]
  },
  {
   "s": 32.34,
   "e": 35.24,
   "text": "जिससे वह किसी भी देवता का आह्वान कर सकती थीं।",
   "chunks": [
    [
     32.34,
     35.24
    ]
   ]
  },
  {
   "s": 35.97,
   "e": 40.93,
   "text": "एक दिन जिज्ञासावश कुंती ने उस मंत्र से सूर्य देव का आह्वान कर दिया।",
   "chunks": [
    [
     35.97,
     37.47
    ],
    [
     37.84,
     40.93
    ]
   ]
  },
  {
   "s": 41.54,
   "e": 44.65,
   "text": "और तभी सूर्य देव उनके सामने प्रकट हो गए।",
   "chunks": [
    [
     41.54,
     44.65
    ]
   ]
  },
  {
   "s": 45.4,
   "e": 46.34,
   "text": "कुंती घबरा गईं।",
   "chunks": [
    [
     45.4,
     46.34
    ]
   ]
  },
  {
   "s": 46.87,
   "e": 52.15,
   "text": "उन्होंने बताया कि उन्होंने यह मंत्र सिर्फ उसकी शक्ति परखने के लिए इस्तेमाल किया था।",
   "chunks": [
    [
     46.87,
     52.15
    ]
   ]
  },
  {
   "s": 52.73,
   "e": 55.97,
   "text": "लेकिन सूर्य देव के वरदान से वह गर्भवती हो गईं।",
   "chunks": [
    [
     52.73,
     55.97
    ]
   ]
  },
  {
   "s": 56.72,
   "e": 60.11,
   "text": "कुछ समय बाद कुंती ने एक ऐसे पुत्र को जन्म दिया,",
   "chunks": [
    [
     56.72,
     60.11
    ]
   ]
  },
  {
   "s": 60.51,
   "e": 65.78,
   "text": "जिसके शरीर पर जन्म से ही सोने का कवच और कानों में दिव्य कुंडल थे।",
   "chunks": [
    [
     60.51,
     65.78
    ]
   ]
  },
  {
   "s": 66.48,
   "e": 68.3,
   "text": "यह कोई साधारण बालक नहीं था।",
   "chunks": [
    [
     66.48,
     68.3
    ]
   ]
  },
  {
   "s": 68.88,
   "e": 70.51,
   "text": "वह सूर्य देव का पुत्र था।",
   "chunks": [
    [
     68.88,
     70.51
    ]
   ]
  },
  {
   "s": 71.16,
   "e": 74.79,
   "text": "लेकिन अब कुंती के सामने सबसे बड़ा संकट था।",
   "chunks": [
    [
     71.16,
     71.83
    ],
    [
     72.2,
     74.79
    ]
   ]
  },
  {
   "s": 75.39,
   "e": 76.58,
   "text": "वह अविवाहित थीं।",
   "chunks": [
    [
     75.39,
     76.58
    ]
   ]
  },
  {
   "s": 77.17,
   "e": 80.98,
   "text": "उन्हें डर था कि अगर इस बच्चे के जन्म का सच सामने आ गया,",
   "chunks": [
    [
     77.17,
     80.98
    ]
   ]
  },
  {
   "s": 81.37,
   "e": 83.18,
   "text": "तो समाज में उनकी बदनामी होगी।",
   "chunks": [
    [
     81.37,
     83.18
    ]
   ]
  },
  {
   "s": 83.84,
   "e": 86.5,
   "text": "और फिर उन्होंने एक ऐसा फैसला लिया,",
   "chunks": [
    [
     83.84,
     86.5
    ]
   ]
  },
  {
   "s": 86.5,
   "e": 89.82,
   "text": "जिसका दर्द शायद जिंदगी भर उनके दिल में रहा।",
   "chunks": [
    [
     86.5,
     89.82
    ]
   ]
  },
  {
   "s": 90.55,
   "e": 94.77,
   "text": "उन्होंने अपने नवजात बेटे को एक टोकरी में रखा और नदी में बहा दिया।",
   "chunks": [
    [
     90.55,
     94.77
    ]
   ]
  },
  {
   "s": 95.43,
   "e": 98.22,
   "text": "लेकिन किस्मत ने उस बच्चे को मरने नहीं दिया।",
   "chunks": [
    [
     95.43,
     98.22
    ]
   ]
  },
  {
   "s": 98.87,
   "e": 101.41,
   "text": "वह टोकरी एक सारथी अधिरथ को मिली।",
   "chunks": [
    [
     98.87,
     101.41
    ]
   ]
  },
  {
   "s": 102.07,
   "e": 108.93,
   "text": "अधिरथ और उनकी पत्नी राधा ने उस बच्चे को अपना बेटा बना लिया और उसका नाम रखा वसुषेण।",
   "chunks": [
    [
     102.07,
     106.21
    ],
    [
     106.64,
     107.82
    ],
    [
     108.21,
     108.93
    ]
   ]
  },
  {
   "s": 109.62,
   "e": 112.09,
   "text": "यही बच्चा आगे चलकर कर्ण बना...",
   "chunks": [
    [
     109.62,
     112.09
    ]
   ]
  },
  {
   "s": 112.66,
   "e": 114.6,
   "text": "महाभारत का महान धनुर्धर।",
   "chunks": [
    [
     112.66,
     114.6
    ]
   ]
  },
  {
   "s": 115.44,
   "e": 117.45,
   "text": "लेकिन सबसे बड़ा दुर्भाग्य देखो...",
   "chunks": [
    [
     115.44,
     117.45
    ]
   ]
  },
  {
   "s": 118.12,
   "e": 121.95,
   "text": "कर्ण जिस माँ की पहचान के लिए जिंदगी भर अनजान रहा,",
   "chunks": [
    [
     118.12,
     121.95
    ]
   ]
  },
  {
   "s": 122.4,
   "e": 124.63,
   "text": "वही कुंती उसकी असली माँ थी।",
   "chunks": [
    [
     122.4,
     124.63
    ]
   ]
  },
  {
   "s": 125.35,
   "e": 128.2,
   "text": "जिस बेटे को उसने कभी अपनाने की हिम्मत नहीं की,",
   "chunks": [
    [
     125.35,
     128.2
    ]
   ]
  },
  {
   "s": 128.64,
   "e": 133.56,
   "text": "वही बेटा आगे चलकर उसके दूसरे बेटों के खिलाफ युद्ध करने वाला था।",
   "chunks": [
    [
     128.64,
     133.56
    ]
   ]
  },
  {
   "s": 134.25,
   "e": 138.04,
   "text": "और शायद कर्ण की जिंदगी का सबसे बड़ा दुख यही था...",
   "chunks": [
    [
     134.25,
     138.04
    ]
   ]
  },
  {
   "s": 138.64,
   "e": 143.44,
   "text": "कि उसे दुनिया से अपनी पहचान साबित करने के लिए पूरी जिंदगी लड़ना पड़ा,",
   "chunks": [
    [
     138.64,
     143.44
    ]
   ]
  },
  {
   "s": 143.92,
